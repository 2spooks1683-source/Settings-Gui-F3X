local function createSectionBanner(name, text, yPos)
	local banner = Instance.new("TextLabel")
	banner.Name = name
	banner.Size = UDim2.new(1, -28, 0, 46)
	banner.Position = UDim2.new(0, 14, 0, yPos)
	banner.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	banner.Text = text
	banner.TextColor3 = Color3.fromRGB(255, 255, 255)
	banner.Font = Enum.Font.Arial
	banner.TextSize = 25
	banner.Parent = MainFrame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(215, 0, 0)
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = banner

	return banner
end

local function createStyledButton(parent, text, size, pos)
	local btn = Instance.new("TextButton")
	btn.Name = text
	btn.Size = size
	btn.Position = pos
	btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.Arial
	btn.TextScaled = true
	btn.TextWrapped = true
	btn.Parent = parent

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 3)
	padding.PaddingBottom = UDim.new(0, 3)
	padding.PaddingLeft = UDim.new(0, 3)
	padding.PaddingRight = UDim.new(0, 3)
	padding.Parent = btn

	local textConstraint = Instance.new("UITextSizeConstraint")
	textConstraint.MaxTextSize = 18
	textConstraint.MinTextSize = 8
	textConstraint.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(215, 75, 0)
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = btn

	return btn
end


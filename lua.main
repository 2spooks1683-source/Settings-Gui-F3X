setupButtonAction("Particle Spam", function() local Players = game:GetService("Players"); local LocalPlayer = Players.LocalPlayer; local PARTICLE_TEXTURE = "128430398966048"; local function getF3XRemote() local tool; if LocalPlayer.Character then tool = LocalPlayer.Character:FindFirstChild("Building Tools+") end; if not tool and LocalPlayer:FindFirstChild("Backpack") then tool = LocalPlayer.Backpack:FindFirstChild("Building Tools+") end; if not tool then for _, v in ipairs(LocalPlayer:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end end; if not tool then for _, v in ipairs(game.ReplicatedStorage:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end end; if tool then return tool:FindFirstChild("SyncAPI") and tool.SyncAPI:FindFirstChild("ServerEndpoint") end; return nil end; local remote = getF3XRemote(); if not remote then return end; local function _(args) pcall(function() remote:InvokeServer(unpack(args)) end) end; local function SpawnParticle(part) _({"CreateDecorations", {{["Part"] = part, ["DecorationType"] = "ParticleEmitter"}}}) end; local function SyncParticle(part) _({"SyncDecorate", {{["Part"] = part, ["DecorationType"] = "ParticleEmitter", ["Texture"] = "rbxassetid://" .. PARTICLE_TEXTURE, ["Size"] = "1", ["Speed"] = 5, ["Rate"] = 50, ["Lifetime"] = 999999, ["SpreadAngle"] = 50, ["LightEmission"] = 1, ["LightInfluence"] = 0}}}) end; local function removeExisting(part) for _, v in ipairs(part:GetChildren()) do if v:IsA("ParticleEmitter") then v:Destroy() end end end; local processedParts = {}; local function applyToPart(part) if not part:IsA("BasePart") then return end; if processedParts[part] then return end; processedParts[part] = true; task.spawn(function() removeExisting(part); SpawnParticle(part); task.wait(0.05); SyncParticle(part) end) end; for _, obj in ipairs(workspace:GetDescendants()) do if obj:IsA("BasePart") then applyToPart(obj) end end; workspace.DescendantAdded:Connect(function(obj) if obj:IsA("BasePart") then task.wait(0.1); applyToPart(obj) end end); workspace.DescendantRemoving:Connect(function(obj) processedParts[obj] = nil end) end)

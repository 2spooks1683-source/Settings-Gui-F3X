setupButtonAction("1x3x5x6 Skybox", function() local Players = game:GetService("Players") local LocalPlayer = Players.LocalPlayer local function getF3XRemote() local tool for _, v in ipairs(LocalPlayer:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end if not tool then for _, v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end end if tool and tool:FindFirstChild("SyncAPI") then return tool, tool.SyncAPI:FindFirstChild("ServerEndpoint") end return nil, nil end local btools, remote = getF3XRemote() if not remote then return end local function runSync(args) task.spawn(function() pcall(function() remote:InvokeServer(unpack(args)) end) end) end local lighting = game:GetService("Lighting") local s = Instance.new("Sky") s.Name = "Skybox" s.Parent = lighting s.SkyboxBk = "rbxassetid://11309167223" s.SkyboxDn = "rbxassetid://11309167223" s.SkyboxFt = "rbxassetid://11309167223" s.SkyboxLf = "rbxassetid://11309167223" s.SkyboxRt = "rbxassetid://11309167223" s.SkyboxUp = "rbxassetid://11309167223" end)

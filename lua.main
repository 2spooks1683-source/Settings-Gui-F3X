MusicsContainer.Parent = MainFrame

local musicList = {
	"ME ME ME! short", "FNAF", "k00pkidd's c00l Music", "PINGU ZONE", "PINGU ZONE [Earrape]", "Allah V2", "c00lkidd Allah V2",
	"Mario Exe Theme", "Bodypartz", "You Get Nothing", "OMFG Hello", "1x1x1x1 Theme [Gothic 0.92]", "1x1x1x1 Theme [Opening]", "Electro Sp00k [Protokidd Ver]",
	"Wonga", "Electro Sp00k Bypassed", "SSS Dubstep Not Pitched", "Jumpstyle Epic", "Gangsta Paradise", "Megalovania Undertale", "Nyan Cat",
	"Wont Stop Us", "Stadium Rave A", "Body Rollz", "Distraction Dance", "Its Raining Men", "Raining Tacos", "Turkic March",
	"Spongebob Pirate Rap", "Silly Dance", "Monster Mash", "N Word Funk", "Mining Away", "Wild Turkey Nights", "Can Can",
	"Windows Sparta Remix", "Is This Sparta Remix", "Nitrovision", "Noel Dayı VS Eminem", "Racist Eminem", "AI slop Manifest Song", "Empty",
	"Shedletsky Laugh", "1x1x1x1 Laugh", "I. M. Meen SFX", "TAKLAYA GELDİK SARP!!", "Neck Hurts", "Empty", "Empty"
}

local mCols = 7
local mBtnW = 60
local mBtnH = 40
local mGap = 5

for i, musicName in ipairs(musicList) do
	local col = (i - 1) % mCols
	local row = math.floor((i - 1) / mCols)
	local x = col * (mBtnW + mGap)
	local y = row * (mBtnH + mGap)
	createStyledButton(MusicsContainer, musicName, UDim2.new(0, mBtnW, 0, mBtnH), UDim2.new(0, x, 0, y))
end

createSectionBanner("UpgradedServerDestroyBanner", "Upgraded Server Destroy", 505)

local DestroyContainer = Instance.new("Frame")
DestroyContainer.Name = "DestroyContainer"
DestroyContainer.Size = UDim2.new(1, -28, 0, 185)
DestroyContainer.Position = UDim2.new(0, 14, 0, 565)
DestroyContainer.BackgroundTransparency = 1
DestroyContainer.Parent = MainFrame

local destroyGroups = {
	{
		xOffset = 0,
		items = {
			"Skybox", "Team Amblem Sky",
			"Hack Definition Skybox", "1x3x5x6 Skybox",
			"Team c00lkidd Amblem Sky", "FE Bypass Skybox"
		}
	},
	{
		xOffset = 148,
		items = {
			"Decal Spam", "Hack Definition Decal Spam",
			"Particle Spam", "Anonymous Particles",
			"Skeleton Particles", "illuminati Particles"
		}
	},
	{
		xOffset = 314,
		items = {
			"666", "666 [Blue]",
			"Anonymous Destroy", "c00lify",
			"Crash Server", "Kick Server"
		}
	}
}

local dBtnW = 66
local dBtnH = 56
local dGap = 6

for _, group in ipairs(destroyGroups) do
	for i, itemText in ipairs(group.items) do
		local col = (i - 1) % 2
		local row = math.floor((i - 1) / 2)
		local x = group.xOffset + col * (dBtnW + dGap)
		local y = row * (dBtnH + dGap)
		createStyledButton(DestroyContainer, itemText, UDim2.new(0, dBtnW, 0, dBtnH), UDim2.new(0, x, 0, y))
	end
end
